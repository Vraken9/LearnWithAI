# Environment Variables Template (Security by Design: DO NOT PUT REAL SECRETS HERE)
# Copy this file to .env.local for local development.

# Supabase Local Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-local-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-local-service-role-key-placeholder

# AI Model Provider (Google Gemini / OpenAI / Anthropic)
# Server-side only: never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
