# Security by Design: Ignored sensitive files and environments
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
serviceAccountKey*.json
*credentials*.json
*secret*.json
id_rsa*
id_ed25519*

# Supabase local sensitive files
.supabase/
supabase/.temp/
supabase/.branches/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build outputs
/.next/
/out/
/build
/dist

# Testing & Coverage
/coverage

# Debug and system logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Deployment
.vercel

# TypeScript
*.tsbuildinfo
